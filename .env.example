# Public origin of the Strapi CMS. MUST be set at build time as well as
# runtime — next/image's remote pattern is derived from it and compiled in.
STRAPI_URL=http://localhost:1337

# Optional. Only needed if the CMS is not publicly readable.
STRAPI_API_TOKEN=

# ISR window, seconds.
STRAPI_REVALIDATE=300

# Canonical site origin, used for metadata, sitemap and JSON-LD.
SITE_URL=http://localhost:3000

# Shared secret for the Strapi -> Next revalidation webhook.
# Must match REVALIDATE_SECRET in the CMS environment.
REVALIDATE_SECRET=
