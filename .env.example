# Public origin of the Strapi CMS. MUST be set at build time as well as
# runtime — next/image's remote pattern is derived from it and compiled in.
STRAPI_URL=http://localhost:1337

# Optional. Only needed if the CMS is not publicly readable.
STRAPI_API_TOKEN=

# ISR window, seconds.
STRAPI_REVALIDATE=300

# Canonical site origin, used for metadata, sitemap and JSON-LD.
SITE_URL=http://localhost:3000

# Shared secret for the Strapi -> Next revalidation webhook.
# Must match REVALIDATE_SECRET in the CMS environment.
REVALIDATE_SECRET=

# The Google tag. Already live on the WordPress site, and it fans out to both
# destinations configured behind it: G-6KMG6ZQ9EF (GA4) and AW-17860291080
# (Google Ads). Using the same tag keeps analytics continuous across the
# migration instead of restarting at zero on the day every URL changed.
#
# Leave UNSET in development and on preview deploys — local clicks and preview
# traffic must not land in the firm's real reporting.
NEXT_PUBLIC_GOOGLE_TAG_ID=GT-NN6G692R
